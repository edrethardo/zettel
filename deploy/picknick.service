# Der Web-Prozess (Spec 12). Ein systemd-User-Service, kein System-Service:
# der Shop läuft als der angemeldete Benutzer, liest dessen Datei und braucht
# kein root.
#
# Ohne `loginctl enable-linger <benutzer>` endet dieser Dienst beim Abmelden —
# siehe README, Abschnitt „Betrieb".

[Unit]
Description=Picknick — privater Bestell-Shop im Tailnet
Documentation=file://%h/code/picknick_klon/README.md

[Service]
Type=exec
WorkingDirectory=%h/code/picknick_klon

# .venv/bin/python und NICHT python3: das System-Python bringt ein zu altes
# `websockets` mit, uvicorns Auto-Erkennung importiert es und der Start
# zerbricht an einem ImportError (gemessen 2026-08-28, siehe den Kommentar in
# picknick/web/app.py:serve). Das venv hat `websockets` gar nicht — genau
# deshalb lädt es sauber.
ExecStart=%h/code/picknick_klon/.venv/bin/python -m picknick.web.app

Environment=PICKNICK_DB=%h/code/picknick_klon/data/picknick.db
Environment=PICKNICK_IMAGE_DIR=%h/code/picknick_klon/data/images
# PICKNICK_HOST bleibt ungesetzt: die Vorgabe in app.py ist die beim Start
# selbst erkannte Tailnet-Adresse dieser Maschine plus localhost (WB-388).
# Wer hier überschreibt, kommt an `pruefe_host()` trotzdem nicht vorbei —
# 0.0.0.0 wird abgelehnt und der Prozess startet nicht (Spec 10).

# Beim Hochfahren steht tailscaled unter Umständen noch nicht. Erzwingt
# PICKNICK_HOST dann eine Tailnet-Adresse, scheitert das Binden und hier wird
# schlicht neu versucht — eine Ordnungsbeziehung auf einen System-Dienst kann
# ein User-Manager nicht auflösen. Mit der erkannten Vorgabe startet der Shop
# stattdessen nur auf loopback; solange die User-Dienste erst mit der
# Anmeldung starten (Linger=no), tritt der Fall nicht auf.
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
