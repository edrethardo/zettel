# Der Web-Prozess (Spec 12). Ein systemd-User-Service, kein System-Service:
# der Shop läuft als der angemeldete Benutzer, liest dessen Datei und braucht
# kein root.
#
# Ohne `loginctl enable-linger <benutzer>` endet dieser Dienst beim Abmelden —
# siehe README, Abschnitt „Betrieb".

[Unit]
Description=Zettel — privater Bestell-Shop im Tailnet
Documentation=file://%h/code/picknick_klon/README.md

[Service]
Type=exec
WorkingDirectory=%h/code/picknick_klon

# .venv/bin/python und NICHT python3: das System-Python bringt ein zu altes
# `websockets` mit, uvicorns Auto-Erkennung importiert es und der Start
# zerbricht an einem ImportError (gemessen 2026-08-28, siehe den Kommentar in
# zettel/web/app.py:serve). Das venv hat `websockets` gar nicht — genau
# deshalb lädt es sauber.
ExecStart=%h/code/picknick_klon/.venv/bin/python -m zettel.web.app

Environment=ZETTEL_DB=%h/code/picknick_klon/data/picknick.db
Environment=ZETTEL_IMAGE_DIR=%h/code/picknick_klon/data/images
# ZETTEL_HOST bleibt ungesetzt: die Vorgabe in app.py ist die beim Start
# selbst erkannte Tailnet-Adresse dieser Maschine plus localhost (WB-388).
# Wer hier überschreibt, kommt an `pruefe_host()` trotzdem nicht vorbei —
# 0.0.0.0 wird abgelehnt und der Prozess startet nicht (Spec 10).

# Beim Hochfahren steht tailscaled unter Umständen noch nicht, und der Shop
# sucht seine Bindeadressen nur EINMAL: dann lauscht er allein auf loopback,
# der Dienst ist grün und das Telefon erreicht nichts — ein Fehler, der wie
# Betrieb aussieht. Eine Ordnungsbeziehung auf einen System-Dienst kann ein
# User-Manager nicht auflösen, also wird gewartet. Das Skript scheitert nie:
# ohne Tailscale startet der Shop nach der Frist auf loopback, denn vom
# Rechner selbst erreichbar ist mehr als gar nicht.
#
# Ohne `loginctl enable-linger` starten die User-Dienste ohnehin erst mit der
# Anmeldung, und dann ist tailscaled längst oben — die Wartezeit ist in dem
# Fall eine Schleife, die einmal durchläuft.
ExecStartPre=%h/code/picknick_klon/deploy/warte-auf-tailnet.sh

# `on-failure` und nicht `always`: ein von Hand gestoppter Shop soll gestoppt
# bleiben. Ein Absturz kommt zurück, ein `systemctl --user stop` nicht.
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
